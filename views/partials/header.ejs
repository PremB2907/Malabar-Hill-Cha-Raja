<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
  <meta name="theme-color" content="#7F1D1D">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Malabar Hill Cha Raja">
  <title><%= typeof title !== 'undefined' ? title : 'Malabar Hill Cha Raja | Shree Bal Gopal Ganeshutsav Mandal' %></title>
  <meta name="description" content="Official Portal of Malabar Hill Cha Raja - Shree Bal Gopal Ganeshutsav Mandal. Immersive digital temple experience, live darshan, history, committee & donation.">
  
  <!-- Open Graph & Social Sharing Meta Tags -->
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Malabar Hill Cha Raja | Shree Bal Gopal Ganeshutsav Mandal' %>">
  <meta property="og:description" content="Official Portal of Malabar Hill Cha Raja (Est. 1973, Reg. E-3892). Live Ganeshotsav Aarti Darshan, 10-year historical photo archive, social work & 80G tax exempt donations.">
  <meta property="og:image" content="https://saileela-eight.vercel.app/images/malabar_ganpati_1.jpg">
  <meta property="og:url" content="https://saileela-eight.vercel.app">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">

  <!-- JSON-LD Structured Data Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Shree Bal Gopal Ganeshutsav Mandal",
    "alternateName": "Malabar Hill Cha Raja",
    "url": "https://saileela-eight.vercel.app",
    "logo": "https://saileela-eight.vercel.app/images/logo.png",
    "foundingDate": "1973"
  }
  </script>
  
  <!-- Google Web Fonts & Devanagari Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Noto+Serif+Devanagari:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400&family=Rozha+One&display=swap" rel="stylesheet">
  
  <!-- FontAwesome & Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Swiper.js & GSAP -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- Internationalization System -->
  <script>
    (function(){
      try {
        var saved = localStorage.getItem('mhr_lang');
        var cookieMatch = document.cookie.match(/mhr_lang=(mr|en)/);
        var l = saved || (cookieMatch ? cookieMatch[1] : '<%= typeof lang !== "undefined" ? lang : "mr" %>');
        document.documentElement.lang = l;
        document.documentElement.setAttribute('data-lang', l);
        document.cookie = "mhr_lang=" + l + "; path=/; max-age=31536000; SameSite=Lax";
      } catch(e){}
    })();
  </script>
  <script src="/js/i18n.js"></script>
  <!-- Malabar Hill Cha Raja Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body>

  <!-- Studio Custom Interactive Follower Cursor -->
  <div class="custom-cursor-dot" id="customCursorDot"></div>
  <div class="custom-cursor-outline" id="customCursorOutline"></div>

  <!-- Mandal Top Header Banner -->
  <div class="topbar-chintamani top-utility-bar" id="topUtilityBar">
    <div class="container">
      <div class="mandal-top-banner-flex">
        <!-- Top Meta (Est & Reg & Social Links) -->
        <div class="mandal-top-meta">
          <span class="est-text" data-i18n="est_label"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'स्थापना : १९७३' : 'Est. Year: 1973' %></span>
          
          <div class="mandal-top-meta-actions">
            <a href="https://www.youtube.com/@MalabarHillChaRaja-e2z" target="_blank" rel="noopener noreferrer" class="social-link yt-link">
              <i class="fa-brands fa-youtube" style="color: #FF0000;"></i>
            </a>
            <a href="https://www.facebook.com/malabarhillcharaja" target="_blank" rel="noopener noreferrer" class="social-link fb-link">
              <i class="fa-brands fa-facebook" style="color: #1877F2;"></i>
            </a>
            <a href="https://www.instagram.com/malabarhill_cha_raja/" target="_blank" rel="noopener noreferrer" class="social-link insta-link">
              <i class="fa-brands fa-instagram" style="color: var(--royal-gold);"></i>
            </a>
            <!-- Language Switcher Pills -->
            <div class="lang-switcher-container">
              <button class="lang-btn <%= typeof lang !== 'undefined' && lang === 'mr' ? 'active' : '' %>" data-lang="mr">मराठी</button>
              <button class="lang-btn <%= typeof lang === 'undefined' || lang === 'en' ? 'active' : '' %>" data-lang="en">English</button>
            </div>
          </div>

          <span class="reg-text" data-i18n="reg_label"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'नोंदणी क्र. : ई-३८९२ मुंबई' : 'Reg No: E-3892 Mumbai' %></span>
        </div>

        <!-- Mandal Devanagari Heading -->
        <h1 class="mandal-banner-3d-text" data-i18n="mandal_full_title">
          <%= typeof lang !== 'undefined' && lang === 'mr' ? 'श्री बाल गोपाल गणेशोत्सव मंडळ, मुंबई' : 'Shree Bal Gopal Ganeshutsav Mandal, Mumbai' %>
        </h1>
      </div>
    </div>
  </div>

  <!-- Main Site Sticky Header -->
  <header class="site-header">
    <div class="container header-inner">
      <!-- Official Mandal Logo Crest with Motion Frame -->
      <a href="/" class="brand-logo">
        <div class="logo-motion-wrapper">
          <div class="logo-motion-ring"></div>
          <img src="/images/logo.png" alt="Malabar Hill Cha Raja Logo" style="width: 100%; height: 100%; object-fit: contain; position: relative; z-index: 1;">
        </div>
        <div class="brand-text">
          <h2 data-i18n="mandal_name_header"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'मालाबार हिलचा राजा' : 'Malabar Hill Cha Raja' %></h2>
          <p data-i18n="mandal_sub_header"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'सार्वजनिक श्री गणेशोत्सव मंडळ' : 'Sarvajanik Shri Ganeshotsav Mandal' %></p>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="main-nav" id="mainNav">
        <ul>
          <!-- Mobile Language Switcher -->
          <li class="mobile-lang-item">
            <div class="lang-switcher-container">
              <button class="lang-btn <%= typeof lang !== 'undefined' && lang === 'mr' ? 'active' : '' %>" data-lang="mr">मराठी</button>
              <button class="lang-btn <%= typeof lang === 'undefined' || lang === 'en' ? 'active' : '' %>" data-lang="en">English</button>
            </div>
          </li>
          <li>
            <button class="btn btn-outline nav-live-btn" id="btnLiveDarshanModal">
              <i class="fa-solid fa-tower-broadcast" style="color: var(--primary-saffron);"></i> <span data-i18n="nav_live">LIVE DARSHAN</span>
            </button>
          </li>
          <li><a href="/" class="nav-link <%= activeTab === 'home' ? 'active' : '' %>" data-i18n="nav_home"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'मुखपृष्ठ' : 'Home' %></a></li>
          <li><a href="/about" class="nav-link <%= activeTab === 'about' ? 'active' : '' %>" data-i18n="nav_about"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'आमच्याबद्दल' : 'About Us' %></a></li>
          <li><a href="/schedule" class="nav-link <%= activeTab === 'schedule' ? 'active' : '' %>" data-i18n="nav_schedule"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'वेळापत्रक' : 'Schedule' %></a></li>
          <li><a href="/glimpses" class="nav-link <%= activeTab === 'glimpses' || activeTab === 'photobooth' ? 'active' : '' %>" data-i18n="nav_glimpses"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'क्षणचित्रे' : 'Glimpses' %></a></li>
          <li><a href="/social-work" class="nav-link <%= activeTab === 'socialwork' ? 'active' : '' %>" data-i18n="nav_socialwork"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'सामाजिक कार्य' : 'Social Work' %></a></li>
          <li><a href="/tshirt" class="nav-link <%= activeTab === 'tshirt' ? 'active' : '' %>" data-i18n="nav_tshirt"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'टी-शर्ट' : 'Official T-Shirt' %></a></li>
          <li><a href="/committee" class="nav-link <%= activeTab === 'committee' ? 'active' : '' %>" data-i18n="nav_committee"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'कार्यकारिणी' : 'Committee' %></a></li>
          <li><a href="/advertise" class="nav-link <%= activeTab === 'advertise' ? 'active' : '' %>" data-i18n="nav_advertise">जाहिरात</a></li>
          <li><a href="/dbt" class="nav-link <%= activeTab === 'dbt' ? 'active' : '' %>" data-i18n="nav_dbt">थेट बँक हस्तांतरण</a></li>
          <li><a href="/contact" class="nav-link <%= activeTab === 'contact' ? 'active' : '' %>" data-i18n="nav_contact"><%= typeof lang !== 'undefined' && lang === 'mr' ? 'संपर्क' : 'Contact' %></a></li>
          
          <!-- Distinct Donate Button -->
          <li class="nav-donate-item">
            <a href="/donate" class="btn btn-primary nav-donate-btn" data-i18n="nav_donate">
              <%= typeof lang !== 'undefined' && lang === 'mr' ? 'देणगी' : 'Donate Now' %>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Mobile Navigation Toggle -->
      <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle menu">
        <i class="bi bi-list"></i>
      </button>
    </div>
  </header>

  <!-- Live Video Popup Modal -->
  <div id="videoModal" class="chintamani-modal">
    <div class="chintamani-modal-content">
      <div class="chintamani-modal-header">
        <div style="display: flex; align-items: center; gap: 0.8rem;">
          <img src="/images/logo.png" alt="Logo" style="width: 36px; height: 36px;">
          <div>
            <span style="color: var(--gold-soft); font-weight: 800; font-size: 0.8rem; text-transform: uppercase;">Malabar Hill Cha Raja</span>
            <h3 style="color: #FFFFFF; font-size: 1.1rem; margin: 0;">Live Ganeshotsav Aarti & Mandap Stream</h3>
          </div>
        </div>
        <button type="button" id="btnCloseVideoModal" style="background: none; border: none; color: #FFFFFF; font-size: 1.8rem; cursor: pointer;">&times;</button>
      </div>
      <div style="padding: 1rem; background: #000000; text-align: center;">
        <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
          <iframe id="videoFrame" src="https://www.youtube.com/@MalabarHillChaRaja-e2z" style="position: absolute; top:0; left:0; width:100%; height:100%; border:none;" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>

