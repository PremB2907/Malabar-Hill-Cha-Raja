        <button class="filter-pill" data-filter="aarti" data-i18n="filter_aarti">Devotion & Aarti</button>
      </div>

      <!-- 3D Crazy Scroll Reel -->
      <div class="crazy-reel-wrapper">
        <button class="crazy-reel-nav-btn prev" aria-label="Previous Slide">
          <i class="fa-solid fa-chevron-left"></i>
        </button>

        <div class="crazy-reel-container">
          <% (typeof glimpsesData !=='undefined' ? glimpsesData : []).forEach(item=> { %>
            <div class="crazy-reel-card gold-motion-frame gallery-card-item" data-category="<%= item.category %>"
              data-lightbox data-lightbox-src="<%= item.image %>"
              data-lightbox-title="<%= item.title %> (Year <%= item.year %>)" data-lightbox-caption="<%= item.desc %>">
              <div class="card-img-box">
                <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy">
                <div class="year-badge">Year <%= item.year %>
                </div>
                <div class="enlarge-hint">
                  <i class="fa-solid fa-magnifying-glass-plus" style="color: var(--royal-gold); margin-right: 4px;"></i>
                  <span data-i18n="btn_enlarge">Zoom Image</span>
                </div>
              </div>
              <div class="card-content">
                <h4 class="card-title">
                  <%= item.title %>
                </h4>
                <p class="card-subtitle">
                  <%= item.theme %>
                </p>
              </div>
            </div>
            <% }); %>
        </div>

        <button class="crazy-reel-nav-btn next" aria-label="Next Slide">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>

