        <div class="flip-clock-grid">
          <div class="flip-unit-wrap">
            <div class="flip-clock-unit" id="flipUnitDays">
              <span class="flip-val" id="countDays">--</span>
            </div>
            <span class="timer-label-txt" data-i18n="label_days"
              style="margin-top: 6px; font-weight: 700; color: var(--gold-soft);">Days</span>
          </div>

